---
title: Despliegue inicial en Railway (un proyecto por entorno - staging y production)
---
flowchart LR
  user["Navegadores<br/>tenant y staff"]
  khipu["Khipu<br/>(webhooks salientes)"]
  dns["DNS + TLS<br/>dominio propio; CDN/WAF opcional delante"]

  subgraph railway["Railway project: wanka-production"]
    direction TB
    web["web<br/>Docker: Next.js standalone<br/>publico :3000<br/>2 replicas"]
    api["api<br/>Docker: wanka serve --plane=tenant<br/>publico solo /webhooks/khipu/{routeId} y /livez, /readyz<br/>privado :8080 para web"]
    papi["platform-api<br/>misma imagen, --plane=platform<br/>solo red privada"]
    worker["worker<br/>misma imagen, wanka worker<br/>sin puerto publico"]
    migrate["pre-deploy command<br/>wanka migrate up (goose)<br/>rol wanka_migrator"]
    pg[("Postgres<br/>servicio gestionado Railway<br/>volumen + backups")]
    bucket[("Bucket S3 compatible<br/>XML, CDR, PDF, adjuntos")]
  end

  secrets["Variables de entorno por servicio (solo nombres):<br/>DATABASE_URL_APP, DATABASE_URL_WORKER,<br/>DATABASE_URL_PLATFORM, DATABASE_URL_MIGRATOR,<br/>DB_POOL_MAX_CONNS, HTTP_READ_TIMEOUT,<br/>S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,<br/>KHIPU_BASE_URL, INTEGRATIONS_ENC_KEY (cifra las API keys fk_ y secretos whsec_ por tenant guardados en la BD),<br/>TOTP_ENC_KEY, TOKEN_PEPPER,<br/>SMTP_URL, WHATSAPP_API_TOKEN,<br/>API_INTERNAL_URL, PLATFORM_API_INTERNAL_URL,<br/>OTEL_EXPORTER_OTLP_ENDPOINT, LOG_LEVEL, APP_ENV"]

  user --> dns --> web
  khipu --> dns --> api
  web -->|"railway.internal"| api
  web -->|"railway.internal"| papi
  api --> pg
  papi --> pg
  worker --> pg
  migrate --> pg
  api --> bucket
  worker --> bucket
  worker -->|"HTTPS"| khipu
  secrets -.-> api
  secrets -.-> papi
  secrets -.-> worker
  secrets -.-> web
