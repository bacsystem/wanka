---
title: Despliegue inicial en Railway (un proyecto por entorno - staging y production)
---
flowchart LR
  user["Navegadores<br/>tenant y staff"]
  khipu["Khipu<br/>(API de CPE y webhooks salientes;<br/>conserva XML, CDR y PDF)"]
  dns["DNS + TLS<br/>dominio propio; CDN/WAF opcional delante"]

  subgraph railway["Railway project: wanka-production"]
    direction TB
    web["web<br/>Docker: Next.js standalone<br/>UNICO dominio publico de la app :3000<br/>2 replicas"]
    webhooks["webhooks<br/>misma imagen Go, wanka serve --plane=webhooks<br/>dominio publico propio: el binario SOLO monta<br/>/webhooks/khipu/{routeId}, /livez, /readyz<br/>rol de BD wanka_webhooks"]
    api["api<br/>wanka serve --plane=tenant<br/>SIN dominio publico: solo api.railway.internal:8080<br/>(/v1/* no es alcanzable desde internet)"]
    papi["platform-api<br/>wanka serve --plane=platform<br/>SIN dominio publico"]
    worker["worker<br/>wanka worker<br/>sin puerto"]
    migrate["pre-deploy command<br/>wanka migrate up (goose)<br/>rol wanka_migrator"]
    pg[("Postgres<br/>servicio gestionado Railway<br/>volumen + backups")]
  end

  secrets["Variables de entorno por servicio (solo nombres):<br/>DATABASE_URL_APP (api), DATABASE_URL_WORKER (worker),<br/>DATABASE_URL_WEBHOOKS (webhooks), DATABASE_URL_PLATFORM (platform-api),<br/>DATABASE_URL_MIGRATOR (pre-deploy),<br/>DB_POOL_MAX_CONNS por servicio: api 20, worker 10, webhooks 5, platform-api 5 (suma 41 con el pre-deploy, menor que max_connections), HTTP_READ_TIMEOUT,<br/>KHIPU_BASE_URL, INTEGRATIONS_ENC_KEY (SOLO api y worker: cifra las API keys fk_),<br/>WEBHOOK_SECRET_ENC_KEY (api al conectar Khipu y webhooks: cifra los whsec_; webhooks NO recibe INTEGRATIONS_ENC_KEY),<br/>TOTP_ENC_KEY, TOKEN_PEPPER,<br/>SMTP_URL, WHATSAPP_API_TOKEN,<br/>API_INTERNAL_URL, PLATFORM_API_INTERNAL_URL,<br/>OTEL_EXPORTER_OTLP_ENDPOINT, LOG_LEVEL, APP_ENV"]

  user --> dns --> web
  khipu --> dns --> webhooks
  web -->|"railway.internal"| api
  web -->|"railway.internal"| papi
  api --> pg
  papi --> pg
  worker --> pg
  webhooks --> pg
  migrate --> pg
  api -->|"HTTPS: XML, CDR y PDF bajo demanda"| khipu
  worker -->|"HTTPS"| khipu
  secrets -.-> api
  secrets -.-> papi
  secrets -.-> worker
  secrets -.-> webhooks
  secrets -.-> web
