---
title: compras + finanzas (esquemas purch, fin)
---
erDiagram
  SUPPLIERS ||--o{ PURCHASE_ORDERS : recibe
  PURCHASE_ORDERS ||--|{ PURCHASE_ORDER_LINES : contiene
  SUPPLIERS ||--o{ PURCHASE_DOCUMENTS : emite
  PURCHASE_ORDERS ||--o{ PURCHASE_DOCUMENTS : "se factura en"
  PURCHASE_DOCUMENTS ||--o| PAYABLES : genera
  PAYABLES ||--o{ PAYABLE_PAYMENTS : paga
  CASH_SHIFTS ||--o{ CASH_MOVEMENTS : registra
  CASH_SHIFTS ||--o{ CASH_COUNTS : arquea
  CASH_SHIFTS ||--o| Z_REPORTS : cierra
  SUPPLIERS ||--o{ CONSIGNMENTS : "entrega en consignacion"
  CONSIGNMENTS ||--|{ CONSIGNMENT_LINES : contiene
  CONSIGNMENTS ||--o{ SUPPLIER_RETURNS : "se devuelve en"
  SUPPLIER_RETURNS ||--|{ SUPPLIER_RETURN_LINES : contiene
  CONSIGNMENTS ||--o{ CONSIGNMENT_SETTLEMENTS : liquida
  CONSIGNMENT_SETTLEMENTS ||--o| PURCHASE_DOCUMENTS : "se factura en"
  RECEIVABLES ||--o{ RECEIVABLE_INSTALLMENTS : cuotas
  RECEIVABLES ||--o{ RECEIVABLE_PAYMENTS : cobra

  SUPPLIERS {
    uuid id PK
    uuid tenant_id "RLS"
    text ruc "UK tenant_id+ruc"
    text name
    text payment_terms
    text sunat_status "habido, no_habido (cache de consulta)"
    text status "activo, observado, inactivo"
  }
  PURCHASE_ORDERS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid supplier_id FK
    uuid warehouse_id FK
    text series
    bigint number "UK tenant+series+number"
    text status "pendiente, parcial, recibida, cancelada"
    date expected_on
    numeric total "numeric(14,2)"
  }
  PURCHASE_ORDER_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid order_id FK
    uuid variant_id FK
    numeric qty "numeric(14,4)"
    numeric qty_received "numeric(14,4)"
    numeric unit_cost "numeric(18,6)"
  }
  PURCHASE_DOCUMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid supplier_id FK
    text doc_type "01, 03, 07, 14"
    text series
    text number "UK tenant+supplier+doc_type+series+number"
    text cuo "correlativo unico de operacion"
    date issue_date
    numeric base "numeric(14,2)"
    numeric igv "numeric(14,2)"
    numeric total "numeric(14,2)"
    numeric detraction_rate "numeric(5,2)"
    numeric detraction_amount "numeric(14,2)"
    text sire_status "aceptado, discrepancia, excluido"
    text expense_class
  }
  PAYABLES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid purchase_document_id FK "UK"
    date due_on "indice tenant+status+due_on"
    numeric total "numeric(14,2)"
    numeric balance "numeric(14,2) CHECK 0..total"
    text status "programada, por_vencer, vencida, pagada"
  }
  PAYABLE_PAYMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid payable_id FK
    numeric amount "numeric(14,2) CHECK > 0"
    date paid_on
  }
  RECEIVABLES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid customer_id FK
    uuid document_id "comprobante en facturacion-electronica"
    numeric total "numeric(14,2)"
    numeric balance "numeric(14,2) CHECK 0..total"
    text status "al_dia, por_vencer, vencido, judicial"
  }
  RECEIVABLE_INSTALLMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid receivable_id FK
    int seq "UK receivable_id+seq"
    date due_on
    numeric amount "numeric(14,2)"
  }
  RECEIVABLE_PAYMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid receivable_id FK
    uuid cash_movement_id FK "nullable"
    numeric amount "numeric(14,2)"
  }
  CONSIGNMENTS {
    uuid id PK "flag compras.consignacion (libreria primero)"
    uuid tenant_id "RLS"
    uuid supplier_id FK "distribuidora"
    uuid warehouse_id FK
    date received_on
    date return_by "plazo de devolucion, alerta antes"
    text status "abierta, en_liquidacion, cerrada"
  }
  CONSIGNMENT_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid consignment_id FK
    uuid variant_id FK
    numeric qty_received "numeric(14,4)"
    numeric qty_sold "numeric(14,4), lo actualiza la venta"
    numeric qty_returned "numeric(14,4); CHECK sold + returned <= received"
    numeric unit_cost "numeric(18,6) acordado"
  }
  SUPPLIER_RETURNS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid supplier_id FK
    uuid consignment_id FK "nullable: tambien devoluciones de compra propia"
    date due_on "plazo"
    text status "borrador, enviada, aceptada"
    uuid dispatch_guide_id "GRE motivo devolucion, si aplica"
  }
  SUPPLIER_RETURN_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid return_id FK
    uuid variant_id FK
    numeric qty "numeric(14,4) CHECK > 0"
  }
  CONSIGNMENT_SETTLEMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid consignment_id FK
    date period_end
    numeric amount "numeric(14,2) vendido x costo acordado"
    uuid purchase_document_id FK "factura de la distribuidora"
  }
  CASH_SHIFTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid cash_register_id FK "UK parcial: un turno abierto por caja"
    uuid opened_by
    timestamptz opened_at
    numeric opening_amount "numeric(14,2)"
    text status "abierto, en_arqueo, cerrado"
    uuid closed_by
    uuid supervisor_id
    timestamptz closed_at
  }
  CASH_MOVEMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid shift_id FK
    text kind "ingreso, egreso, retiro"
    text method "efectivo, yape, plin, tarjeta, transferencia"
    numeric amount "numeric(14,2) CHECK > 0"
    text source_type "sale, receivable_payment, expense, withdrawal"
    uuid source_id
    text status "valido, anulado"
  }
  CASH_COUNTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid shift_id FK
    text method
    numeric theoretical "numeric(14,2)"
    numeric counted "numeric(14,2)"
    jsonb denominations "solo efectivo"
  }
  Z_REPORTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid shift_id FK "UK"
    text series "Z"
    bigint number "UK tenant+series+number"
    numeric expected "numeric(14,2)"
    numeric counted "numeric(14,2)"
    numeric difference "numeric(14,2)"
    jsonb snapshot "totales por metodo y tipo de doc, inmutable"
    text hash "sha256 del snapshot"
  }
