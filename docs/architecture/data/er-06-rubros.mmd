---
title: rubros - extensiones de dominio (esquemas lube, books; resto resumido)
---
erDiagram
  CUSTOMERS ||--o{ VEHICLES : posee
  VEHICLES ||--o{ SERVICE_ORDERS : ingresa
  SERVICE_ORDERS ||--|{ SERVICE_ORDER_LINES : contiene
  SERVICE_ORDERS ||--o{ SERVICE_ORDER_INSPECTIONS : diagnostica
  SERVICE_ORDERS ||--o| SALES : "se cobra en"
  VEHICLES ||--o{ ODOMETER_READINGS : registra
  VEHICLES ||--o{ MAINTENANCE_REMINDERS : programa
  SERVICE_RULES ||--o{ MAINTENANCE_REMINDERS : origina
  ITEMS ||--o| BOOK_DETAILS : "extiende (1:1)"
  BOOK_DETAILS }o--o{ AUTHORS : "escrito por"
  PUBLISHERS ||--o{ BOOK_DETAILS : publica
  SCHOOLS ||--o{ SCHOOL_LISTS : publica
  SCHOOL_LISTS ||--|{ SCHOOL_LIST_ITEMS : contiene
  ITEM_VARIANTS ||--o{ SCHOOL_LIST_ITEMS : sugiere

  CUSTOMERS {
    uuid id PK "core clientes"
  }
  SALES {
    uuid id PK "core ventas"
  }
  ITEMS {
    uuid id PK "core catalogo"
  }
  ITEM_VARIANTS {
    uuid id PK "core catalogo"
  }
  VEHICLES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid customer_id FK
    text plate "normalizada mayusculas sin guion; UK tenant_id+plate"
    text vin "nullable"
    text brand
    text model
    smallint year
    text fuel "gasolina, diesel, glp, gnv, hibrido"
    int current_km "CHECK >= 0"
    numeric km_per_day_est "numeric(8,2), calculado"
  }
  ODOMETER_READINGS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid vehicle_id FK
    int km "CHECK >= 0"
    timestamptz read_at
    text source "orden_servicio, cliente, manual"
  }
  SERVICE_ORDERS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid site_id FK
    uuid vehicle_id FK
    text series "OT"
    bigint number "UK tenant+series+number"
    int km_in "CHECK >= 0"
    text bay "bahia o rampa"
    uuid technician_id
    text status "abierta, en_proceso, terminada, facturada, cancelada; cobro al contado, sin credito"
    uuid sale_id FK "UK, nullable hasta facturar"
    timestamptz opened_at
    timestamptz closed_at
  }
  SERVICE_ORDER_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid order_id FK
    uuid variant_id FK "aceite, filtro o servicio de mano de obra"
    numeric qty "numeric(14,4), entero: solo productos envasados"
    numeric unit_price "numeric(14,4)"
    uuid reservation_id "reserva de stock"
  }
  SERVICE_ORDER_INSPECTIONS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid order_id FK
    text component "filtro_aire, filtro_aceite (lista abierta)"
    text condition "bueno, regular, cambiar"
    text note
  }
  SERVICE_RULES {
    uuid id PK
    uuid tenant_id "RLS"
    text service_kind "cambio_aceite"
    int every_km "default 5000: proximo = km actual + 5000"
    int every_days "fecha del proximo servicio, vence lo primero (valor por PO)"
  }
  MAINTENANCE_REMINDERS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid vehicle_id FK
    uuid rule_id FK
    uuid service_order_id "OT que lo origino"
    int due_km "km de la OT + every_km"
    date due_on "indice tenant+status+due_on"
    text channels "whatsapp y correo"
    text status "programado, enviado, atendido, descartado"
  }
  BOOK_DETAILS {
    uuid item_id PK, FK
    uuid tenant_id "RLS"
    text isbn13 "CHECK digito verificador; indice tenant+isbn13"
    text title
    text edition
    smallint pub_year
    uuid publisher_id FK
    text language
  }
  AUTHORS {
    uuid id PK
    uuid tenant_id "RLS"
    text name
  }
  PUBLISHERS {
    uuid id PK
    uuid tenant_id "RLS"
    text name "UK tenant+name"
  }
  SCHOOLS {
    uuid id PK
    uuid tenant_id "RLS"
    text name
    text district
  }
  SCHOOL_LISTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid school_id FK
    smallint school_year
    text grade "UK tenant+school+year+grade"
    text status "borrador, publicada"
  }
  SCHOOL_LIST_ITEMS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid list_id FK
    uuid variant_id FK "nullable si aun no existe en catalogo"
    text requested_text "texto original de la lista"
    numeric qty "numeric(14,4); la lista se cobra al contado, sin descuentos por convenio"
  }
