---
title: identidad + empresas (esquemas iam y org)
---
erDiagram
  TENANTS ||--o{ SITES : tiene
  TENANTS ||--o{ MEMBERSHIPS : agrupa
  USERS ||--o{ MEMBERSHIPS : pertenece
  ROLES ||--o{ MEMBERSHIPS : asigna
  ROLES ||--o{ ROLE_PERMISSIONS : concede
  PERMISSIONS ||--o{ ROLE_PERMISSIONS : en
  MEMBERSHIPS ||--o{ MEMBERSHIP_SITES : alcance
  SITES ||--o{ MEMBERSHIP_SITES : en
  USERS ||--o{ USER_TOTP : protege
  USERS ||--o{ SESSIONS : abre
  USERS ||--o{ PASSWORD_RESETS : solicita
  SITES ||--o{ CASH_REGISTERS : tiene
  SITES ||--o{ DOCUMENT_SERIES : emite
  CASH_REGISTERS ||--o{ DOCUMENT_SERIES : usa
  TENANTS ||--|| TENANT_SETTINGS : configura

  TENANTS {
    uuid id PK
    text ruc UK "CHECK 11 digitos"
    text legal_name
    text trade_name
    text industry "lubricentro, libreria, restaurante, veterinaria, odontologia, retail"
    text status "trial, activa, suspendida, cerrada (solo lectura 5 anios)"
    timestamptz closed_at "purga programada a closed_at + 5 anios"
    timestamptz created_at
    timestamptz updated_at
  }
  TENANT_SETTINGS {
    uuid tenant_id PK, FK
    text tax_regime
    text ubigeo
    text default_currency "PEN; USD tambien desde R1"
    boolean allow_negative_stock "default false"
    jsonb print_settings
    bigint version "concurrencia optimista"
  }
  SITES {
    uuid id PK
    uuid tenant_id FK "RLS"
    text code "UK tenant_id+code"
    text name
    text sunat_annex "codigo de establecimiento anexo, 4 digitos"
    text address
    timestamptz created_at
  }
  CASH_REGISTERS {
    uuid id PK
    uuid tenant_id FK "RLS"
    uuid site_id FK
    text code "UK tenant_id+code, ej. CAJA-01"
    boolean active
  }
  DOCUMENT_SERIES {
    uuid id PK
    uuid tenant_id FK "RLS"
    uuid site_id FK
    uuid cash_register_id FK "nullable"
    text doc_type "01,03,07,08,09 o interno: PRO, OC, Z, OT"
    text series "UK tenant_id+doc_type+series, CHECK formato"
    bigint last_number "CHECK >= 0, fila caliente"
    boolean active
  }
  USERS {
    uuid id PK
    citext email UK
    text full_name
    text password_hash "argon2id PHC"
    boolean email_verified
    text status "activo, bloqueado"
    int failed_logins
    timestamptz locked_until
    timestamptz created_at
  }
  USER_TOTP {
    uuid user_id PK, FK
    bytea secret_enc "cifrado AES-GCM, clave en env"
    timestamptz confirmed_at
    text recovery_codes_hash "array de hashes"
  }
  SESSIONS {
    uuid id PK
    uuid user_id FK
    uuid tenant_id "nullable hasta elegir empresa"
    uuid site_id "nullable"
    bytea access_hash UK "sha256 del token"
    timestamptz access_expires_at
    bytea refresh_hash UK
    uuid refresh_family
    timestamptz refresh_expires_at
    boolean mfa_passed
    inet ip
    text user_agent
    timestamptz revoked_at
    timestamptz created_at "indice para limpieza"
  }
  PASSWORD_RESETS {
    uuid id PK
    uuid user_id FK
    bytea token_hash UK
    timestamptz expires_at "15 min"
    timestamptz used_at
  }
  ROLES {
    uuid id PK
    uuid tenant_id FK "RLS; plantillas del sistema copiadas al provisionar"
    text name "UK tenant_id+name"
    boolean system
    boolean requires_mfa "true en propietario, administrador, contador"
  }
  PERMISSIONS {
    text code PK "modulo.recurso:accion, ej. ventas.pos:create"
    text module "catalogo global, sin tenant"
    text description
  }
  ROLE_PERMISSIONS {
    uuid tenant_id "RLS"
    uuid role_id PK, FK
    text permission_code PK, FK
  }
  MEMBERSHIPS {
    uuid id PK
    uuid tenant_id FK "RLS"
    uuid user_id FK "UK tenant_id+user_id"
    uuid role_id FK
    boolean all_sites
    text status "invitado, activo, suspendido"
    bigint authz_version "se incrementa al cambiar rol"
  }
  MEMBERSHIP_SITES {
    uuid tenant_id "RLS"
    uuid membership_id PK, FK
    uuid site_id PK, FK
  }
