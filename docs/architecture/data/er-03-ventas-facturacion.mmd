---
title: ventas + facturacion-electronica (esquemas sales, einv) - toda UNIQUE natural empieza por tenant_id
---
erDiagram
  SALES ||--|{ SALE_LINES : contiene
  SALES ||--|{ SALE_PAYMENTS : cobra
  SALES ||--o| ELECTRONIC_DOCUMENTS : "se documenta en"
  QUOTES ||--|{ QUOTE_LINES : contiene
  QUOTES ||--o{ SALES : "se convierte en"
  ELECTRONIC_DOCUMENTS ||--|{ EDOC_LINES : contiene
  ELECTRONIC_DOCUMENTS ||--o{ EDOC_EVENTS : historial
  ELECTRONIC_DOCUMENTS ||--o{ ELECTRONIC_DOCUMENTS : "NC/ND referencia a"
  ELECTRONIC_DOCUMENTS ||--o{ VOIDINGS : "baja solicitada"
  DOCUMENT_SERIES ||--o{ ELECTRONIC_DOCUMENTS : numera
  DOCUMENT_SERIES ||--o| SERIES_EMITTERS : "un emisor a la vez"
  PROVIDER_CREDENTIALS ||--o{ ELECTRONIC_DOCUMENTS : "emite con"
  WEBHOOK_ROUTES ||--|| PROVIDER_CREDENTIALS : "resuelve tenant de"
  ELECTRONIC_DOCUMENTS ||--o{ PROVIDER_WEBHOOK_EVENTS : notifica

  SALES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid site_id FK
    uuid cash_register_id FK "caja del turno, define la serie"
    uuid shift_id FK "turno abierto: FOR SHARE en la tx de venta"
    uuid customer_id FK "FK compuesta tenant_id+customer_id"
    uuid quote_id FK "nullable"
    text status "completada, anulada"
    char currency "PEN, USD"
    numeric exchange_rate "numeric(6,3) soles por USD; NOT NULL si USD, NULL si PEN (CHECK)"
    numeric subtotal "numeric(14,2) CHECK >= 0"
    numeric igv "numeric(14,2) CHECK >= 0"
    numeric total "numeric(14,2) CHECK > 0 y total = subtotal + igv + otros"
    text idempotency_key "UK tenant_id+idempotency_key"
    timestamptz sold_at
    uuid created_by
  }
  SALE_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid sale_id FK
    uuid variant_id FK
    text description
    numeric qty "numeric(14,4) CHECK > 0"
    numeric unit_price "numeric(14,4) con IGV, en la moneda de la venta, CHECK > 0"
    numeric discount "numeric(14,2) CHECK >= 0 y <= qty x unit_price"
    text discount_reason "obligatorio si discount > 0"
    uuid discount_approved_by "supervisor si supera el tope del rol"
    text igv_affectation
    numeric line_total "numeric(14,2) CHECK > 0"
  }
  SALE_PAYMENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid sale_id FK
    text method "efectivo, tarjeta, yape, plin, transferencia, credito (credito solo factura)"
    char currency "PEN, USD: moneda en que paga el cliente"
    numeric amount "numeric(14,2) CHECK > 0, en currency"
    numeric exchange_rate "numeric(6,3) si currency distinta de la venta"
    numeric amount_in_sale_currency "numeric(14,2) CHECK > 0"
    text reference "lote POS, operacion"
  }
  QUOTES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid customer_id FK
    text series "PRO..."
    bigint number "UK tenant+series+number"
    text status "borrador, enviada, aprobada, vencida, convertida"
    char currency "PEN, USD"
    date expires_on
    numeric total "numeric(14,2) CHECK > 0"
    bytea approval_token_hash "UK global: token aleatorio del enlace publico"
  }
  QUOTE_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid quote_id FK
    uuid variant_id FK
    numeric qty "numeric(14,4) CHECK > 0"
    numeric unit_value "numeric(14,4) sin IGV CHECK > 0"
    numeric discount_pct "numeric(5,2) CHECK 0..100"
  }
  DOCUMENT_SERIES {
    uuid id PK
    bigint last_number
  }
  SERIES_EMITTERS {
    uuid tenant_id PK "RLS"
    uuid series_id PK "se crea con la serie; ademas el upsert ON CONFLICT (tenant_id, series_id) la crea si falta"
    text holder "id del job River"
    timestamptz lease_until "now() + 60 s; renovacion solo WHERE holder = job, 0 filas = abortar"
    timestamptz wakeup_at "un solo job dormido por serie hasta el next_attempt_at de la cabeza"
  }
  ELECTRONIC_DOCUMENTS {
    uuid id PK "tambien Idempotency-Key hacia Khipu"
    uuid tenant_id "RLS"
    text doc_type "01 factura, 03 boleta, 07 NC, 08 ND, 09 GRE"
    uuid series_id FK
    text series
    bigint number "UK tenant_id+doc_type+series+number; null en GRE hasta que Khipu numere"
    text issuer_ruc
    uuid source_sale_id "nullable"
    uuid related_document_id FK "NC/ND"
    text note_reason_code "catalogo 09 o 10"
    char currency "PEN, USD (GRE: null)"
    numeric exchange_rate "numeric(6,3) = tipo_cambio de Khipu (3 enteros, 3 decimales); NOT NULL si USD"
    text status "pendiente, enviado, aceptado, observado, rechazado, anulado"
    smallint status_rank "1..5, transiciones solo hacia rango mayor"
    text provider_status "estado crudo de Khipu, ej. ERROR_ENVIO, PENDIENTE_AGRUPACION"
    text blocked_reason "validation, quota, auth, sunat_ya_lo_tiene, config o null"
    int attempts
    timestamptz next_attempt_at
    text provider "khipu"
    text provider_ref "datos.id de Khipu; se graba si es NULL, sin depender del estado"
    text sunat_code
    text sunat_message
    text hash "digest del XML firmado"
    numeric provider_total "numeric(14,2) totales.total de Khipu, se compara con total"
    bytea xml_sha256 "sha256 del XML de Khipu, se fija en la primera descarga; XML, CDR y PDF los conserva Khipu"
    date issue_date
    timestamptz send_deadline "fecha_limite_envio de Khipu, alerta si se acerca"
    numeric total "numeric(14,2) CHECK >= 0 (GRE 0)"
    bigint version
  }
  EDOC_LINES {
    uuid id PK
    uuid tenant_id "RLS"
    uuid document_id FK
    text code
    text description
    numeric qty "numeric(14,4) CHECK > 0"
    text unit_code
    numeric unit_value "numeric(14,4) sin IGV"
    numeric igv "numeric(14,2) CHECK >= 0"
    numeric total "numeric(14,2) CHECK >= 0"
  }
  EDOC_EVENTS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid document_id FK
    text from_status
    text to_status
    text detail
    timestamptz at
  }
  VOIDINGS {
    uuid id PK
    uuid tenant_id "RLS"
    uuid document_id FK "UK parcial tenant_id+document_id WHERE status en curso"
    text reason "obligatorio"
    text provider_void_id "id de la baja en Khipu"
    text identifier "RA-... o RC-..."
    text status "solicitada, generada, enviada, aceptada, rechazada, error_envio"
    timestamptz requested_at "base de la cadencia de sondeo, tope 24 h"
    timestamptz stalled_at "sin estado final a las 24 h, alerta La baja no se ha resuelto"
  }
  PROVIDER_CREDENTIALS {
    uuid tenant_id PK "esquema integ, RLS"
    text provider PK "khipu"
    bytea api_key_enc "fk_... cifrada AES-GCM con INTEGRATIONS_ENC_KEY; sin GRANT para wanka_webhooks"
    text environment "BETA, PRODUCCION"
    text provider_company_ref "id de la empresa en Khipu, lo da el operador en el comando de activacion"
    text provider_plan "gratis, emprende, negocio, pro: declarado por el operador; CHECK environment BETA o plan distinto de gratis"
    timestamptz verified_at "llave verificada con una lectura"
    timestamptz activated_at "lo fija el comando wanka einvoicing activate (temporal hasta la consola, issue 86), con audit.events"
    text activated_by "correo del operador de Khipu que corrio el comando"
    timestamptz emission_ready_at "certificado, SOL y series cargados y conexion correcta (issue 55): recien ahi se emite"
    timestamptz webhook_verified_at "primer evento firmado recibido, lo escribe el worker en cpe.sync; mientras sea null, alerta"
  }
  WEBHOOK_ROUTES {
    text route_id PK "ops.webhook_routes SIN RLS: 128 bits aleatorios; wanka_webhooks solo via ops.resolve_webhook_route()"
    uuid tenant_id "a que tenant pertenece la ruta"
    text provider "khipu"
    bytea webhook_secret_enc "whsec_ cifrado con WEBHOOK_SECRET_ENC_KEY (clave propia, no INTEGRATIONS_ENC_KEY); NOT NULL, la fila la crea completa el comando de activacion"
    timestamptz revoked_at
  }
  PROVIDER_WEBHOOK_EVENTS {
    uuid tenant_id PK "RLS"
    text provider PK
    text event_id PK "X-Khipu-Delivery, dedupe por tenant"
    text event_type "comprobante.aceptado..."
    text doc_series "datos.serie"
    bigint doc_number "datos.numero"
    jsonb payload
    timestamptz received_at
    timestamptz processed_at
  }
