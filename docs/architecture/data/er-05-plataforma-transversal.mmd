---
title: plataforma (esquema platform, SIN RLS, solo roles de plataforma) + transversales (audit con RLS, ops)
---
erDiagram
  PLANS ||--o{ PLAN_MODULES : incluye
  MODULES ||--o{ PLAN_MODULES : en
  PLANS ||--o{ SUBSCRIPTIONS : contrata
  SUBSCRIPTIONS ||--o{ SAAS_INVOICES : factura
  MODULES ||--o{ TENANT_MODULE_OVERRIDES : ajusta
  FEATURE_FLAGS ||--o{ TENANT_FLAG_OVERRIDES : ajusta
  PLATFORM_USERS ||--o{ PLATFORM_SESSIONS : abre
  PLATFORM_ROLE_PERMISSIONS }o--|| PLATFORM_PERMISSIONS : concede
  PLATFORM_USERS ||--o{ IMPERSONATION_GRANTS : solicita
  PLATFORM_USERS ||--o{ TICKETS : atiende
  PLATFORM_USERS ||--o{ PLATFORM_AUDIT_EVENTS : registra

  MODULES {
    text code PK "ventas, inventario, rubro.lubricentro..."
    text kind "core, rubro, addon"
    text description
  }
  PLANS {
    uuid id PK
    text code UK
    text name
    jsonb limits "usuarios, sedes, CPE por mes"
    boolean active
  }
  PLAN_MODULES {
    uuid plan_id PK, FK
    text module_code PK, FK
  }
  SUBSCRIPTIONS {
    uuid id PK
    uuid tenant_id "UK parcial: una activa por tenant"
    uuid plan_id FK
    text status "trial, activa, morosa, suspendida, cancelada"
    date period_start
    date period_end
  }
  TENANT_MODULE_OVERRIDES {
    uuid tenant_id PK
    text module_code PK, FK
    boolean enabled
    text reason
    uuid set_by
  }
  FEATURE_FLAGS {
    text key PK
    text description
    int rollout_pct "CHECK 0..100"
    boolean default_on
  }
  TENANT_FLAG_OVERRIDES {
    uuid tenant_id PK
    text flag_key PK, FK
    boolean enabled
  }
  TENANT_USAGE {
    uuid tenant_id PK "escribe wanka_worker (GRANT INSERT, UPDATE solo en esta tabla)"
    date period PK "mes"
    int cpe_issued "contador actualizado por el worker"
    int active_users
  }
  SAAS_INVOICES {
    uuid id PK
    uuid subscription_id FK
    text number
    text status "pagado, pendiente, moroso, anulado"
  }
  PLATFORM_USERS {
    uuid id PK
    citext email UK
    text password_hash
    text role "superadmin, soporte, finanzas, ventas, ingenieria"
    boolean totp_required "siempre true"
  }
  PLATFORM_PERMISSIONS {
    text code PK "plataforma.recurso:accion, catalogo separado del de tenant"
    text description
  }
  PLATFORM_ROLE_PERMISSIONS {
    text role PK "superadmin, soporte, finanzas, ventas, ingenieria"
    text permission_code PK, FK
  }
  PLATFORM_SESSIONS {
    uuid id PK
    uuid platform_user_id FK
    bytea access_hash UK
    bytea refresh_hash UK
    timestamptz revoked_at
  }
  IMPERSONATION_GRANTS {
    uuid id PK
    uuid platform_user_id FK
    uuid tenant_id
    uuid ticket_id "obligatorio"
    text scope "read_only o full"
    text status "solicitado, aprobado, rechazado, canjeado, revocado, vencido"
    text reason "motivo visible para la empresa"
    timestamptz redeemed_at
    timestamptz created_at "requested_at en iam.list_support_requests()"
    uuid approved_by "usuario del tenant con identidad.support_access:approve"
    timestamptz approved_at
    timestamptz consent_expires_at "max 24 h desde la aprobacion"
    bytea exchange_token_hash "UK: token de un uso que canjea el plano tenant via iam.redeem_impersonation()"
    timestamptz expires_at "max 60 min"
    timestamptz revoked_at
  }
  TICKETS {
    uuid id PK
    uuid tenant_id
    text priority "P1, P2, P3"
    text status
  }
  AUDIT_LOG {
    uuid id PK "audit.events, solo insercion, particion mensual"
    uuid tenant_id "NOT NULL, RLS; tambien acciones del staff sobre ese tenant"
    text actor_type "user, platform_staff, system"
    uuid actor_user_id
    uuid impersonator_id "si aplica"
    text action "modulo.recurso:accion"
    text entity_type
    uuid entity_id
    text result "ok, denegado"
    inet ip
    text request_id
    jsonb diff
    timestamptz at
  }
  PLATFORM_AUDIT_EVENTS {
    uuid id PK "platform.audit_events SIN RLS: solo wanka_platform"
    uuid platform_user_id FK
    uuid target_tenant_id "nullable"
    text action "tenants:create, tenants:impersonate, plans:update..."
    text result
    inet ip
    text request_id
    jsonb detail
    timestamptz at
  }
  IDEMPOTENCY_KEYS {
    uuid tenant_id PK
    text key PK
    bytea request_hash "sha256 de metodo, ruta y cuerpo canonico"
    smallint status_code "NULL solo dentro de la transaccion; solo 2xx: CHECK status_code BETWEEN 200 AND 299"
    bytea response "bytes exactos de la respuesta"
    jsonb response_headers "Content-Type, Location, ETag"
    timestamptz created_at "limpieza a las 24 h"
  }
  RIVER_JOB {
    bigint id PK "tabla de River (cola y outbox)"
    text kind
    jsonb args "incluye tenant_id"
    text state
    int attempt
    timestamptz scheduled_at
  }
