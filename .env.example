# Entorno local (make up). `make env` copia este archivo a .env.local y reemplaza
# los CHANGE_ME por valores aleatorios. Los de aquí son de ejemplo, no secretos.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
WANKA_ROLE_PASSWORD=CHANGE_ME
WANKA_PG_PORT=55432
WANKA_API_PORT=58080
WANKA_WEB_PORT=3400
# URL de la API que usa el BFF de apps/web (route handlers; obligatoria, sin barra final). `make up` la pasa a la web
# con WANKA_API_PORT; el E2E de Playwright usa este valor o http://127.0.0.1:58080. No lleva secretos ni prefijo NEXT_PUBLIC_.
# WANKA_API_URL=http://127.0.0.1:58080
